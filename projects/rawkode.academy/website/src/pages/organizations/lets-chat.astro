---
import ContactFallback from "@/components/organizations/ContactFallback.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	decisionBriefMailto,
	decisionBriefSubject,
	decisionBriefTemplate,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;
---

<Page title="Partner application" description="Apply for a Rawkode Academy partnership or a product review.">
	<EditorialShell compact eyebrow="Work with Rawkode Academy" title="Tell us about your product."
		lede="Tell us about your product, the people you need to reach, and what you would like to improve. A short email is enough to start.">
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href={decisionBriefMailto}>Start an email</a>
			<a class="editorial-button editorial-button--secondary" href="/organizations/partnerships">See what you get</a>
		</div>

		<section class="editorial-section" aria-labelledby="application-context">
			<div class="editorial-section__header">
				<h2 id="application-context" class="editorial-section__title">What to include in your email</h2>
				<p class="editorial-section__lede">Tell us what your product does, who you want to use it and where they get stuck. Add links to your product, demo, documentation or repository, who needs to be involved and any deadline. You can ask about the partnership, the product review or both.</p>
			</div>
			<ContactFallback subject={decisionBriefSubject} template={decisionBriefTemplate} />
		</section>

		<section class="editorial-section" aria-labelledby="application-next">
			<div class="editorial-section__header">
				<h2 id="application-next" class="editorial-section__title">What happens next?</h2>
				<p class="editorial-section__lede">We will reply with a recommendation: a 90-day partnership, a product review, or neither. If a conversation would help, we’ll arrange a call from there.</p>
			</div>
		</section>
	</EditorialShell>
</Page>
