---
import FAQJsonLD from "@/components/html/faq-jsonld.astro";
import PartnershipApplicationForm from "@/components/organizations/PartnershipApplicationForm.vue";
import PartnershipProof from "@/components/organizations/PartnershipProof.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	applicationPaths,
	fitProofReview,
	partnershipOffer,
	partnershipStartingPoint,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const faqs = [
	{
		question: "Why continue after the review?",
		answer:
			"The report gives your team clear priorities it can use independently. Continue when you want experienced technical judgement as you act on them: which developers to focus on, what to explain and what to build next. Use Slack and the monthly session to revisit progress and agree the next priorities.",
	},
	{
		question: "How does Slack access work?",
		answer:
			"Use Slack Connect for questions and feedback on the work we agree. Questions are normally answered within two business days. Larger requests are discussed in the monthly session or agreed separately. Slack access does not include on-call support or incident response.",
	},
	{
		question: "What do we need to provide?",
		answer:
			"Access to your product and relevant material. For the webinar and runnable example, your team supplies the working environment and code, a technical expert to join the webinar, and someone to check the product details. Your team keeps ownership of the product and code, maintains the environment and handles fixes. We agree what is needed before starting.",
	},
	{
		question: "What does the webinar involve?",
		answer:
			"One joint webinar every 90 days, co-hosted by us and your technical expert. Your team supplies the working environment and code. We review the demo, help plan the session and co-host. Your expert explains the product details. Before starting, we agree where it runs, how it is promoted, whether it is recorded and how any recording may be reused.",
	},
	{
		question: "What guide or code example do we get?",
		answer:
			"One resource to go with the webinar: a short PDF guide or a code repository with an example developers can run. We choose which is useful for the topic and agree who writes the guide or prepares the repository before starting. Your team supplies the working code and fixes problems; we review it and help decide what to explain. Ongoing code repository maintenance is outside the partnership.",
	},
	{
		question: "How do we review progress?",
		answer:
			"In the monthly session, we review progress on the agreed work, discuss your questions and decide what to prioritise next. You get a short written recap in Slack with decisions and next steps. Before the 90 days end, we discuss whether to keep working together.",
	},
	{
		question: "How does renewal work?",
		answer:
			"The first commitment is 90 days at £12,000 before any review credit. If you start directly, it is billed monthly at £4,000. Before it ends, we review the work and agree together whether to continue for another 90 days, and what to work on next.",
	},
	{
		question: "How does the review credit work?",
		answer:
			"Start the partnership within 14 days of the product review call and we credit the full £5,000 review fee against the first £12,000, 90-day commitment. That leaves £7,000 to continue. Including the review payment, the total for the review and the first 90 days is £12,000. Where the review covers the work we agree, we start from those findings instead of repeating it.",
	},
	{
		question: "How is additional work handled?",
		answer:
			"We agree any extra work, its price and timing before starting. Extra webinars, new integrations and ongoing repository maintenance are outside the partnership. Exclusivity needs a separate agreement on the work and price.",
	},
	{
		question: "Does this guarantee praise, coverage or leads?",
		answer:
			"We give honest feedback. Paying for the work does not guarantee praise, leads or separate coverage.",
	},
];

const applyHref = `/organizations/partnerships?route=${encodeURIComponent(applicationPaths[0])}#apply`;
const reviewApplyHref = `/organizations/partnerships?route=${encodeURIComponent(applicationPaths[1])}#apply`;
---

<Page
	title="Partnerships"
	description="Start with a £5,000 product review for guidance on developer adoption. Continue with agreed advice and support at £4,000 a month for 90 days."
>
	<FAQJsonLD questions={faqs} slot="extra-head" />
	<EditorialShell
		eyebrow="Work with Rawkode Academy"
		title="Advice and support for developer adoption."
		lede={partnershipStartingPoint}
	>
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href={reviewApplyHref} data-apply-path={applicationPaths[1]}>Ask for a product review</a>
			<a class="editorial-button editorial-button--secondary" href="#programme">Explore ongoing advice</a>
		</div>


		<section id="review" class="editorial-section editorial-section--split" aria-labelledby="review-title">
			<div class="editorial-section__header">
				<p class="editorial-kicker">{fitProofReview.label}</p>
				<h2 id="review-title" class="editorial-section__title">{fitProofReview.name}</h2>
				<p class="editorial-section__lede">{fitProofReview.summary}</p>
			</div>
			<div class="partner-offer-card">
				<div>
					<p class="partner-offer-card__price">{fitProofReview.price}</p>
				</div>
				<ul class="editorial-list">
					{fitProofReview.included.map((item) => <li>{item}</li>)}
				</ul>
				{fitProofReview.notes.map((note) => <p class="editorial-card__body">{note}</p>)}
				<a class="partner-card__link" href={reviewApplyHref} data-apply-path={applicationPaths[1]}>Ask for a product review</a>
			</div>
		</section>

		<section id="programme" class="editorial-section editorial-section--split" aria-labelledby="programme-title">
			<div class="editorial-section__header">
				<h2 id="programme-title" class="editorial-section__title">{partnershipOffer.name}</h2>
				<p class="editorial-section__lede">{partnershipOffer.summary}</p>
				{partnershipOffer.notes.map((note) => <p class="editorial-section__lede">{note}</p>)}
			</div>
			<div class="partner-offer-card">
				<div>
					<p class="partner-offer-card__price">{partnershipOffer.price}</p>
					<p class="partner-offer-card__cadence">{partnershipOffer.cadence}</p>
				</div>
				<p class="editorial-card__body">For each 90 days, you get:</p>
				<ul class="editorial-list">
					{partnershipOffer.included.map((item) => <li>{item}</li>)}
				</ul>
				<a class="editorial-button" href={applyHref} data-apply-path={applicationPaths[0]}>Apply for the partnership</a>
			</div>
		</section>

		<PartnershipProof />

		<section class="editorial-section editorial-section--split" aria-labelledby="faq-title">
			<div class="editorial-section__header">
				<h2 id="faq-title" class="editorial-section__title">Before you apply</h2>
			</div>
			<div class="editorial-faq">
				{faqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section id="apply" class="editorial-section editorial-section--split partnerships-apply" aria-labelledby="apply-title">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Apply</p>
				<h2 id="apply-title" class="editorial-section__title">Tell us about your product.</h2>
				<p class="editorial-section__lede">Tell us about your product, the developers you want to reach and what you would like to improve. A short description is enough to start.</p>
			</div>
			<div class="partnerships-apply__body">
				<PartnershipApplicationForm client:visible />
			</div>
		</section>
	</EditorialShell>
</Page>

<style>
	.partner-offer-card {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.partner-offer-card__price {
		margin: 0.4rem 0 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.9rem, 5vw, 2.8rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--colors-academy-text);
	}

	.partner-offer-card__cadence {
		margin: 0.15rem 0 0;
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.875rem;
		letter-spacing: 0.02em;
	}

	.partner-card__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.partner-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.partner-card__link:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}

</style>
