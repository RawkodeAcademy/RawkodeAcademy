---
import FAQJsonLD from "@/components/html/faq-jsonld.astro";
import PartnershipApplicationForm from "@/components/organizations/PartnershipApplicationForm.vue";
import PartnershipProof from "@/components/organizations/PartnershipProof.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	applicationPaths,
	fitProofReview,
	partnershipBoundaries,
	partnershipOffer,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const faqs = [
	{
		question: "How does Slack access work?",
		answer:
			"Use Slack Connect to ask David questions and get feedback on the agreed use case. Questions are normally answered within two business days. Larger requests are discussed in the monthly session or agreed separately. Slack access does not include on-call support or incident response.",
	},
	{
		question: "What do we need to provide?",
		answer:
			"A working environment and code, a technical expert to join the webinar, your documentation or repository, and someone to check the product details. Your team maintains the environment and code, builds the product and handles fixes. We agree what is needed before starting.",
	},
	{
		question: "What does the webinar involve?",
		answer:
			"One joint webinar every 90 days, with David and your technical expert. Your team supplies the working environment and code. David reviews the demo, helps plan the session and co-hosts. Your expert explains the product details.",
	},
	{
		question: "What guide or code example do we get?",
		answer:
			"One resource to go with the webinar: a short PDF guide or a code repository with an example developers can run. We choose which is useful for the topic. Your team supplies the working code and fixes problems; David reviews it and helps decide what to explain. Ongoing code repository maintenance is outside the partnership.",
	},
	{
		question: "How do we review progress?",
		answer:
			"In the monthly session, we go through your questions and decide what to improve next. You get a short written recap in Slack with decisions and next steps. There is no separate quarterly report. Before the 90 days end, we discuss whether to keep working together.",
	},
	{
		question: "How does renewal work?",
		answer:
			"The first commitment is 90 days at £12,000, paid in three monthly instalments of £4,000. Before it ends, we review the work and agree together whether to continue for another 90 days, and what to work on next.",
	},
	{
		question: "How does the review credit work?",
		answer:
			"Start the partnership within 30 days of the product demo review call and the full £2,500 comes off your first £4,000 invoice. That leaves £1,500 on the first invoice, followed by two £4,000 invoices. Including the review payment, the total for the review and the first 90 days is £12,000. For the same use case, we start from the review findings instead of repeating the initial review.",
	},
	{
		question: "How is additional work handled?",
		answer:
			"We agree what is included, what it costs and when it happens before starting. Another use case, extra webinars, new integrations or campaign work are not automatically included in the monthly fee.",
	},
];

const process = [
	{
		step: "01",
		title: "Tell us what developers struggle with",
		body: "Tell us who you want to use your product, what you want them to try and where they get stuck.",
	},
	{
		step: "02",
		title: "Choose the topic together",
		body: "Together, we'll choose a useful technical topic and turn it into a webinar and a practical resource developers can use. Your technical expert brings the working environment and code; David reviews the demo, helps plan the webinar and co-hosts.",
	},
	{
		step: "03",
		title: "Get feedback and run the webinar",
		body: "Ask David questions in Slack and review the demo and documentation in monthly sessions. David and your expert co-host the webinar, with one PDF guide or code example to go with it. You get a short written recap in Slack. We agree together whether to continue for another 90 days.",
	},
];

const badFits = partnershipBoundaries;
const applyHref = `/organizations/partnerships?route=${encodeURIComponent(applicationPaths[0])}#apply`;
const reviewApplyHref = `/organizations/partnerships?route=${encodeURIComponent(applicationPaths[1])}#apply`;
---

<Page
	title="Partnerships"
	description="Ask David technical questions, review your demo and documentation, and co-host a webinar. £4,000 a month for 90 days, or start with a £2,500 product demo review."
>
	<FAQJsonLD questions={faqs} slot="extra-head" />
	<EditorialShell
		eyebrow="Work with Rawkode Academy"
		title="Help developers understand your product."
		lede={partnershipOffer.summary}
	>
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href={applyHref} data-apply-path={applicationPaths[0]}>Apply for the partnership</a>
			<a class="editorial-button editorial-button--secondary" href="#programme">See what you get</a>
		</div>

		<PartnershipProof />

		<section id="programme" class="editorial-section editorial-section--split" aria-labelledby="programme-title">
			<div class="editorial-section__header">
				<h2 id="programme-title" class="editorial-section__title">{partnershipOffer.name}</h2>
				<p class="editorial-section__lede">Work on one agreed use case with David for 90 days. Ask questions in Slack and meet each month to review your demo, documentation and what developers need to understand. You get feedback throughout the three months, plus a joint webinar and one guide or code example.</p>
				<p class="editorial-section__lede">Your team supplies and maintains the environment and code, builds the product, fixes problems and runs your campaigns. David answers technical questions, reviews the demo, helps plan the webinar and co-hosts it with your technical expert.</p>
			</div>
			<div class="partner-offer-card">
				<div>
					<p class="partner-offer-card__price">{partnershipOffer.price}</p>
					<p class="partner-offer-card__cadence">{partnershipOffer.cadence}</p>
				</div>
				<p class="editorial-card__body">For each 90 days, you get:</p>
				<ul class="editorial-list">
					{partnershipOffer.included.map((item) => <li>{item}</li>)}
				</ul>
				{partnershipOffer.notes.map((note) => <p class="editorial-card__body">{note}</p>)}
				<a class="editorial-button" href={applyHref} data-apply-path={applicationPaths[0]}>Apply for the partnership</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="review-title">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Optional starting point</p>
				<h2 id="review-title" class="editorial-section__title">{fitProofReview.name}</h2>
				<p class="editorial-section__lede">{fitProofReview.summary}</p>
			</div>
			<div class="partner-offer-card">
				<div>
					<p class="partner-offer-card__price">{fitProofReview.price}</p>
					<p class="partner-offer-card__cadence">{fitProofReview.cadence}</p>
				</div>
				<ul class="editorial-list">
					{fitProofReview.included.map((item) => <li>{item}</li>)}
				</ul>
				{fitProofReview.notes.map((note) => <p class="editorial-card__body">{note}</p>)}
				<a class="partner-card__link" href={reviewApplyHref} data-apply-path={applicationPaths[1]}>Ask for a demo review</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="process-title">
			<div class="editorial-section__header">
				<h2 id="process-title" class="editorial-section__title">How it starts</h2>
			</div>
			<div class="partner-process">
				{process.map((item) => (
					<article class="partner-process__item">
						<span class="partner-process__step">{item.step}</span>
						<h3 class="editorial-card__title">{item.title}</h3>
						<p class="editorial-card__body">{item.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="boundaries-title">
			<div class="editorial-section__header">
				<h2 id="boundaries-title" class="editorial-section__title">What is not included</h2>
			</div>
			<ul class="editorial-list partner-boundaries">
				{badFits.map((item) => <li>{item}</li>)}
			</ul>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="faq-title">
			<div class="editorial-section__header">
				<h2 id="faq-title" class="editorial-section__title">Before you apply</h2>
			</div>
			<div class="editorial-faq">
				{faqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section id="apply" class="editorial-section editorial-section--split partnerships-apply" aria-labelledby="apply-title">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Apply</p>
				<h2 id="apply-title" class="editorial-section__title">Tell David about your product.</h2>
				<p class="editorial-section__lede">Tell us who you want to use your product, what you want them to try and where they get stuck. A short description is enough to start.</p>
			</div>
			<div class="partnerships-apply__body">
				<PartnershipApplicationForm client:visible />
			</div>
		</section>
	</EditorialShell>
</Page>

<style>
	.partner-process__step {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--colors-academy-accent);
	}

	.partner-offer-card {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.partner-offer-card__price {
		margin: 0.4rem 0 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.9rem, 5vw, 2.8rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--colors-academy-text);
	}

	.partner-offer-card__cadence {
		margin: 0.15rem 0 0;
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
	}

	.partner-card__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.partner-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.partner-card__link:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}

	.partner-process {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--colors-academy-border);
		border-bottom: 1px solid var(--colors-academy-border);
	}

	.partner-process__item {
		display: grid;
		gap: 0.5rem;
		padding: 1rem 0;
	}

	.partner-process__item + .partner-process__item {
		border-top: 1px solid var(--colors-academy-border);
	}

	.partner-process__item h3 {
		margin: 0;
	}

	.partner-boundaries {
		margin: 0;
	}

	@media (min-width: 760px) {
		.partner-process__item {
			padding: 1rem;
		}
	}
</style>
