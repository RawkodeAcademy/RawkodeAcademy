---
import { actions } from "astro:actions";
import { getCollection } from "astro:content";
import PartnerLogos from "@/components/organizations/PartnerLogos.astro";
import PartnershipApplicationForm from "@/components/organizations/PartnershipApplicationForm.vue";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	annualPartnershipDetails,
	annualPartnershipOffer,
	exampleMeasures,
	fitProofReview,
	partnershipDescription,
	partnershipOffer,
	partnershipReviewCredit,
	productReviewPath,
	resolveApplicationPath,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-cache");

const reviewApplyHref = `/organizations/partnerships?route=${encodeURIComponent(productReviewPath)}#enquiry-form`;
const initialPath =
	resolveApplicationPath(Astro.url.searchParams.get("route")) ?? "Not sure yet";
const submittedEnquiry = Astro.getActionResult(actions.partnership.applyForm);
const submittedData = submittedEnquiry?.data;
const enquiryReceived =
	submittedData != null &&
	"success" in submittedData &&
	submittedData.success === true;
const enquiryRateLimited =
	submittedData != null &&
	"rateLimited" in submittedData &&
	submittedData.rateLimited === true;
const enquiryFallback =
	submittedData != null &&
	"fallback" in submittedData &&
	submittedData.fallback === "mailto";

const faqs = [
	{
		question: "How is this different from sponsoring a video?",
		answer:
			"A sponsorship buys airtime. Here you pay for David's time and judgement on your product: the first run, the ranked list and the advice. The live session is part of that work, labelled as a partner session, and it teaches a real use case. If the product isn't ready to teach yet, David tells you and the time goes on fixing that first.",
	},
	{
		question:
			"We could come on Rawkode Live for free. What does the review add?",
		answer:
			"A maintainer session is public, about an hour, and you are there steering, so David sees the path you show him. In the review David works alone as your target user, with nobody to rescue him, logs every stall against the recording, ranks what to fix, explain and teach, sets numbers to watch and, if you continue, re-runs it at day 90 to check what changed.",
	},
	{
		question: "Isn't David too experienced to get stuck where our users do?",
		answer:
			"Before starting we agree who he is acting as, such as an application developer who has never run a cluster, and he works to what that person would know. The walkthrough call then checks the ranked list against your own funnel numbers, so findings that don't show up in your data get marked down.",
	},
	{
		question: "Who on our side should own it?",
		answer:
			"Whoever owns developer adoption. Often that is the head of DevRel or developer experience, with product owning the fixes. The ranked list says which items are for product, which for docs and which for DevRel.",
	},
	{
		question: "Can we sponsor content as well?",
		answer:
			"Sponsorship is a separate conversation from the partnership. Neither changes what David tells you in the review.",
	},
	{
		question: "Do open-source maintainers have to pay to come on Rawkode Live?",
		answer:
			"No. Maintainer sessions on Rawkode Live are still free and unpaid, and they aren't labelled as partner sessions. The partnership is for teams who want the review, the advice and the work around the session.",
	},
	{
		question: "How much of our engineers' time does it take?",
		answer:
			"About half a day across the 90 days: an hour to review the runnable example, an hour to prepare the session and the live hour itself. David writes the example. Your product lead joins the monthly sessions.",
	},
	{
		question: "Who is this a good fit for?",
		answer:
			"Developer-tool teams from seed to Series C whose users are platform, cloud-native or AI-infrastructure engineers, with a product someone can install or sign up for and try, including open-source projects installed from GitHub or Helm. The review can follow your open-source install path. There is no separate open-source price.",
	},
	{
		question: "What numbers do we agree, and when?",
		answer: `Two or three numbers you already track, agreed at kick-off. Targets for day 90 are set on the review call, once the findings exist. ${exampleMeasures} We report against them in the read-out using your data.`,
	},
	{
		question: "What happens on the all-partner call?",
		answer:
			"Once a month David and the current partners, at most six teams, spend an hour on what's changing across cloud-native, platform engineering, AI infrastructure and developer tools: new projects, shifts in how teams adopt tools, and what David is hearing from engineers. It isn't recorded and nothing said is repeated outside the call. If you compete directly with another partner, tell us and keep anything sensitive for your one-to-one sessions. Until three partners are active, the call runs one-to-one with David.",
	},
	{
		question: "Why are places limited?",
		answer:
			"David does every review and partnership himself, alongside running Rawkode Academy. Six partners at a time is what he can do properly, and two new reviews a month is what he can start without the existing ones slipping. The limits are the same whether or not places are free. A place is booked when the statement of work is signed and a start date is set; unsigned holds lapse after seven days.",
	},
	{
		question: "How do we stop?",
		answer:
			"Stop after the review and you have paid $5,000, invoiced on delivery. Stop at day 90 and there is nothing further to pay. Nothing renews automatically.",
	},
];
const partnershipReviewHeroTitle =
	"See exactly where engineers get stuck with your product.";

const quoteIds = [
	"reggie-wilkerson",
	"jens-neuse",
	"solomon-hykes",
	"mikkel-hegnhoj",
] as const;

const quoteContext = {
	"reggie-wilkerson":
		"On advisory work: positioning, demos and ongoing guidance",
	"jens-neuse": "On David's public walkthrough of WunderGraph on Rawkode Live",
	"solomon-hykes": "On having his product used live",
	"mikkel-hegnhoj":
		"On Advent of Spin, the hands-on challenges Rawkode Academy created for Fermyon",
} as const;

const testimonials = await getCollection("testimonials");
const partnershipQuotes = quoteIds.map((id) => {
	const entry = testimonials.find((item) => item.id === id);
	if (!entry) throw new Error(`Missing partnership quote: ${id}`);
	return { id, entry, context: quoteContext[id] };
});
---

<Page
	title="Partnerships"
	description={partnershipDescription}
>
	<EditorialShell
		eyebrow="Partnerships"
		title={partnershipReviewHeroTitle}
		lede="I review how engineers get started with your product and tell you what to fix first, in order of importance. It's a fixed $5,000."
	>
		<p class="partnership-byline" slot="intro">David Flanagan runs Rawkode Academy and Rawkode Live. The Rawkode Academy YouTube channel has 28.2K subscribers and over 370 hours of live streams.</p>
		<div class="partnership-hero-offer" slot="actions">
			<a class="editorial-button" href={reviewApplyHref} data-apply-path={productReviewPath} data-partnership-cta data-cta-location="hero">Book a product review</a>
			<p class="partnership-hero-proof">I work with Datum Cloud today, and I've worked with Teleport, Heroku, Microsoft Azure and ngrok.</p>
		</div>

		<section id="partner-quotes" class="editorial-section" aria-label="Partner quotes">
			<div class="partnership-quotes">
				{partnershipQuotes.map(({ entry, context }) => (
					<figure>
						<p class="partnership-quotes__context">{context}</p>
						<blockquote>{entry.data.quote.trim()}</blockquote>
						<figcaption>
							{entry.data.author.link ? (
								<a href={entry.data.author.link}>{entry.data.author.name}</a>
							) : (
								entry.data.author.name
							)}, {entry.data.author.title}
						</figcaption>
					</figure>
				))}
			</div>
		</section>

		<section id="fit" class="editorial-section editorial-section--split" aria-labelledby="fit-title">
			<div class="editorial-section__header">
				<h2 id="fit-title" class="editorial-section__title">Is this for you?</h2>
			</div>
			<div class="landing-copy">
				<div class="landing-fit">
					<p>This is a good fit if:</p>
					<ul class="editorial-list">
						<li>you build developer tools such as infrastructure tools, Kubernetes and cloud native projects, cloud platforms or AI infrastructure.</li>
						<li>you're between seed and Series C.</li>
						<li>an engineer can install or sign up for your product and try it, including open-source projects installed from GitHub or Helm.</li>
					</ul>
				</div>
				<div class="landing-fit">
					<p>It's probably not for you if:</p>
					<ul class="editorial-list">
						<li>engineers can't install or sign up for your product and try it.</li>
						<li>you aren't a developer tools company between seed and Series C working in infrastructure, Kubernetes and cloud native, cloud platforms or AI.</li>
						<li>you make a data tool.</li>
					</ul>
				</div>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="what-you-get-title">
			<div class="editorial-section__header">
				<h2 id="what-you-get-title" class="editorial-section__title">What you get</h2>
			</div>
			<div class="landing-copy">
				<p>Within 10 business days, you get a written report showing the places engineers get stuck and what to fix first, in order of importance.</p>
				<p>David agrees the numbers to watch with you and walks your team through the report.</p>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="how-it-works-title">
			<div class="editorial-section__header">
				<h2 id="how-it-works-title" class="editorial-section__title">How it works</h2>
			</div>
			<div class="landing-copy">
				<p>You give David a trial or sandbox account and agree where the run starts and ends. He works privately, delivers the review and invoices only after delivery.</p>
				<p>{partnershipReviewCredit}</p>
			</div>
		</section>

		<section id="pricing" class="editorial-section" aria-labelledby="pricing-title">
			<div class="editorial-section__header">
				<h2 id="pricing-title" class="editorial-section__title">Pricing</h2>
				<p class="editorial-section__lede">{partnershipReviewCredit}</p>
			</div>
			<div class="landing-pricing">
				<article>
					<h3>{fitProofReview.name}</h3>
					<p class="partner-offer-card__price">{fitProofReview.price}</p>
					<p>{fitProofReview.cadence}</p>
					<p>{fitProofReview.summary}</p>
				</article>
				<article>
					<h3>{partnershipOffer.name}</h3>
					<p class="partner-offer-card__price">{partnershipOffer.price}</p>
					<p>{partnershipOffer.cadence}</p>
					<p>{partnershipOffer.summary}</p>
				</article>
				<article>
					<h3>{annualPartnershipOffer.name}</h3>
					<p class="partner-offer-card__price partner-offer-card__price--sentence">{annualPartnershipOffer.cadence}</p>
					<p>{annualPartnershipOffer.summary}</p>
					{annualPartnershipDetails.map((detail) => <p>{detail}</p>)}
					<a class="editorial-button" href="?route=Annual%20plan#apply" data-apply-path="Annual plan" data-partnership-cta data-cta="ask_about_the_annual_plan" data-cta-location="annual">Ask about the annual plan</a>
				</article>
			</div>
		</section>

		<section id="what-you-control" class="editorial-section editorial-section--split" aria-labelledby="what-you-control-title">
			<div class="editorial-section__header">
				<h2 id="what-you-control-title" class="editorial-section__title">What you control</h2>
			</div>
			<div class="landing-copy">
				<p>You decide what each quarter covers, and you own the review, the report and the read-out.</p>
				<p>Stop after the review and you have paid $5,000, invoiced on delivery. Stop at day 90 and there is nothing further to pay. Nothing renews automatically.</p>
			</div>
		</section>

		<section id="who-ive-worked-with" class="editorial-section editorial-section--split" aria-labelledby="who-ive-worked-with-title">
			<div class="editorial-section__header">
				<h2 id="who-ive-worked-with-title" class="editorial-section__title">Who I've worked with</h2>
			</div>
			<PartnerLogos />
		</section>

		<section id="questions" class="editorial-section editorial-section--split" aria-labelledby="questions-title">
			<div class="editorial-section__header">
				<h2 id="questions-title" class="editorial-section__title">Questions</h2>
			</div>
			<div class="partnership-faq">
				{faqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section id="apply" class="editorial-section editorial-section--split partnerships-apply" aria-labelledby="apply-title">
			<div class="editorial-section__header">
				<h2 id="apply-title" class="editorial-section__title">Tell David about your product</h2>
				<p class="editorial-section__lede">A few lines about your product and where engineers get stuck is enough. David replies within two business days and tells you honestly whether the review is worth doing.</p>
				<a class="editorial-button" href={reviewApplyHref} data-apply-path={productReviewPath} data-partnership-cta data-cta-location="end">Book a product review</a>
			</div>
			<div id="enquiry-form" class="partnerships-apply__body">
				{enquiryReceived ? (
					<div>
						<h3>Enquiry received</h3>
						<p>David reads every enquiry and replies within two business days.</p>
					</div>
				) : (
					<>
						{enquiryRateLimited && <p role="alert">Too many enquiries were sent recently. Please wait a minute and try again.</p>}
						{enquiryFallback && <p role="alert">Attio is not available, so your enquiry was not sent automatically. <a href="mailto:david@rawkode.academy">Email David directly</a>.</p>}
						{submittedEnquiry?.error && <p role="alert">Please check the highlighted fields.</p>}
						<PartnershipApplicationForm client:visible initialPath={initialPath} />
					</>
				)}
			</div>
		</section>

	</EditorialShell>
</Page>

<script>
	document.querySelectorAll("[data-partnership-cta]").forEach((cta) => {
		cta.addEventListener("click", () => {
			const label = cta.textContent?.trim() ?? "";
			window.posthog?.capture("cta_clicked", {
				cta: cta.getAttribute("data-cta") ?? "book_a_product_review",
				label,
				location: cta.getAttribute("data-cta-location"),
				path: window.location.pathname,
			});
		});
	});
</script>

<style>
	.partnership-byline,
	.partnership-hero-proof { margin: 0; max-width: 65ch; line-height: 1.55; color: var(--colors-academy-text-muted); }
	.partnership-hero-offer { display: grid; justify-items: start; gap: 0.75rem; }

	.partnership-quotes { display: grid; gap: 1.25rem; }
	.partnership-quotes figure { margin: 0; display: grid; gap: 0.5rem; }
	.partnership-quotes blockquote {
		margin: 0;
		padding-left: 1rem;
		border-left: 2px solid var(--colors-academy-accent);
		color: var(--colors-academy-text);
		line-height: 1.65;
		white-space: pre-wrap;
	}
	.partnership-quotes__context {
		margin: 0;
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--colors-academy-accent);
	}
	.partnership-quotes figcaption {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.8rem;
		color: var(--colors-academy-text-muted);
	}
	.partnership-quotes a {
		color: var(--colors-academy-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.partnership-quotes a:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}

	.landing-copy { display: grid; gap: 0.75rem; max-width: 65ch; }
	.landing-copy p { margin: 0; line-height: 1.65; color: var(--colors-academy-text); }
	.landing-fit { display: grid; gap: 0.35rem; }

	.landing-pricing {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: 1.5rem;
	}
	.landing-pricing article { display: grid; align-content: start; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--colors-academy-border); }
	.landing-pricing article h3,
	.landing-pricing article p { margin: 0; }
	.landing-pricing article p { line-height: 1.55; color: var(--colors-academy-text); }

	.partner-offer-card__price {
		margin: 0.4rem 0 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.9rem, 5vw, 2.8rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--colors-academy-text);
	}

	.partner-offer-card__price--sentence {
		max-width: 30ch;
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		line-height: 1.15;
	}

	#questions .partnership-faq {
		display: grid;
		gap: 0.75rem;
	}

	#questions .partnership-faq details {
		margin: 0;
		padding: 0;
		border: 1px solid var(--colors-academy-border);
		border-radius: 4px;
		background: var(--colors-academy-panel);
	}

	#questions .partnership-faq summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		min-height: 2.75rem;
		padding: 1rem 1.25rem;
		cursor: pointer;
		font-weight: 700;
		color: var(--colors-academy-text);
		list-style: none;
	}

	#questions .partnership-faq summary::-webkit-details-marker {
		display: none;
	}

	#questions .partnership-faq summary::after {
		content: "";
		flex: none;
		width: 0.45rem;
		height: 0.45rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(45deg);
	}

	#questions .partnership-faq details[open] summary::after {
		transform: rotate(225deg);
	}

	#questions .partnership-faq summary:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}

	#questions .partnership-faq details > p {
		margin: 0;
		padding: 0 1.25rem 1.25rem;
		line-height: 1.65;
		color: var(--colors-academy-text);
	}
</style>
