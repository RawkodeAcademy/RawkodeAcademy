---
import FAQJsonLD from "@/components/html/faq-jsonld.astro";
import PartnershipApplicationForm from "@/components/organizations/PartnershipApplicationForm.vue";
import PartnershipExperience from "@/components/organizations/PartnershipExperience.astro";
import PartnershipProof from "@/components/organizations/PartnershipProof.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	applicationPaths,
	fitProofReview,
	partnershipOffer,
	partnershipStartingPoint,
	partnershipDescription,
	partnershipHeroLede,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const faqs = [
	{
		question: "How do we choose the work?",
		answer:
			"We agree the questions, priorities, product access and responsibilities before starting.",
	},
	{
		question: "How does Slack access work?",
		answer:
			"Use Slack Connect for questions and feedback on the agreed work. Questions are normally answered within two business days. Larger requests are discussed in the monthly session or agreed separately. On-call support and incident response are outside the partnership.",
	},
	{
		question: "What does our team provide for the webinar and resource?",
		answer:
			"Your team supplies the working environment and code, a technical expert to join the webinar, and someone to check the product details. Your team makes the decisions, builds the product, keeps ownership of the product and code, maintains the environment and handles fixes. We review the demo, help plan the session and co-host it. We choose a short PDF guide or runnable code repository and agree who prepares it before starting.",
	},
	{
		question: "What do we agree about publishing?",
		answer:
			"Where the webinar runs, how it is promoted, whether it is recorded and how any recording may be reused. We give honest feedback; paying for the work does not guarantee praise, leads or separate coverage.",
	},
	{
		question: "How is additional work handled?",
		answer:
			"We agree any extra work, its price and timing before starting. Extra webinars, new integrations and ongoing repository maintenance are outside the partnership. Exclusivity needs a separate agreement on the work and price.",
	},
];

const applyHref = `/organizations/partnerships?route=${encodeURIComponent(applicationPaths[0])}#apply`;
const reviewApplyHref = `/organizations/partnerships?route=${encodeURIComponent(applicationPaths[1])}#apply`;
---

<Page
	title="Partnerships"
	description={partnershipDescription}
>
	<FAQJsonLD questions={faqs} slot="extra-head" />
	<EditorialShell
		eyebrow="For teams building products for developers"
		title="Build a product developers want to use."
		lede={partnershipHeroLede}
	>
		<p class="partnership-hero-intro" slot="intro">{partnershipStartingPoint}</p>
		<div class="partnership-hero-offer" slot="actions">
			<p class="partnership-hero-commitment">{partnershipOffer.price} for the first 90 days</p>
			<div class="editorial-actions">
				<a class="editorial-button" href={applyHref} data-apply-path={applicationPaths[0]}>Discuss a partnership</a>
				<a class="editorial-button editorial-button--secondary" href="#review">Start with a product review</a>
			</div>
		</div>

		<PartnershipExperience />

		<section class="editorial-section editorial-section--split" aria-labelledby="priorities-title">
			<div class="editorial-section__header">
				<h2 id="priorities-title" class="editorial-section__title">Decide what deserves attention next</h2>
				<p class="editorial-section__lede">When developers struggle, the next step might be a product change, a better setup experience or a clearer explanation. We help your team work through questions such as:</p>
			</div>
			<ul class="editorial-list">
				<li>Which developer problems should we focus on, and which features or fixes can wait?</li>
				<li>What makes the product harder to try, understand or use?</li>
				<li>Which use cases should we explain, and what should we teach?</li>
				<li>What is changing in the industry, and does it change our priorities?</li>
			</ul>
		</section>

		<section id="programme" class="editorial-section editorial-section--split" aria-labelledby="programme-title">
			<div class="editorial-section__header">
				<h2 id="programme-title" class="editorial-section__title">{partnershipOffer.name}</h2>
				<p class="editorial-section__lede">{partnershipOffer.summary}</p>
				{partnershipOffer.notes.map((note) => <p class="editorial-section__lede">{note}</p>)}
			</div>
			<div class="partner-offer-card">
				<div>
					<p class="partner-offer-card__price">{partnershipOffer.price} for the first 90 days</p>
					<p class="partner-offer-card__cadence">{partnershipOffer.cadence}</p>
				</div>
				<p class="editorial-card__body">Included:</p>
				<ul class="editorial-list">
					{partnershipOffer.included.map((item) => <li>{item}</li>)}
				</ul>
				<a class="editorial-button" href={applyHref} data-apply-path={applicationPaths[0]}>Discuss a partnership</a>
				<a class="partner-card__link" href="#faq-title">How the work is scoped</a>
			</div>
		</section>

		<PartnershipProof />

		<section id="review" class="editorial-section editorial-section--split" aria-labelledby="review-title">
			<div class="editorial-section__header">
				<p class="editorial-kicker">{fitProofReview.label}</p>
				<h2 id="review-title" class="editorial-section__title">{fitProofReview.name}</h2>
				<p class="editorial-section__lede">{fitProofReview.summary}</p>
			</div>
			<div class="partner-offer-card">
				<div>
					<p class="partner-offer-card__price">{fitProofReview.price}</p>
				</div>
				<ul class="editorial-list">
					{fitProofReview.included.map((item) => <li>{item}</li>)}
				</ul>
				{fitProofReview.notes.map((note) => <p class="editorial-card__body">{note}</p>)}
				<a class="partner-card__link" href={reviewApplyHref} data-apply-path={applicationPaths[1]}>Ask for a product review</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="faq-title">
			<div class="editorial-section__header">
				<h2 id="faq-title" class="editorial-section__title">Before we start</h2>
			</div>
			<div class="editorial-faq">
				{faqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section id="apply" class="editorial-section editorial-section--split partnerships-apply" aria-labelledby="apply-title">
			<div class="editorial-section__header">
				<h2 id="apply-title" class="editorial-section__title">Tell us about your product.</h2>
				<p class="editorial-section__lede">What are you building, who is it for and what would you like help deciding? A short description is enough to start.</p>
			</div>
			<div class="partnerships-apply__body">
				<PartnershipApplicationForm client:visible />
			</div>
		</section>
	</EditorialShell>
</Page>

<style>
	.partnership-hero-intro { margin: 0; max-width: 68ch; font-family: var(--fonts-academy-text), system-ui, sans-serif; font-size: 1.125rem; line-height: 1.7; color: var(--colors-academy-text-muted); }
	.partnership-hero-offer { display: grid; gap: 1rem; }
	.partnership-hero-commitment { margin: 0; font-family: var(--fonts-academy-text), system-ui, sans-serif; font-size: 1.25rem; font-weight: 750; color: var(--colors-academy-text); }

	.partner-offer-card {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.partner-offer-card__price {
		margin: 0.4rem 0 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.9rem, 5vw, 2.8rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--colors-academy-text);
	}

	.partner-offer-card__cadence {
		margin: 0.15rem 0 0;
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.875rem;
		letter-spacing: 0.02em;
	}

	.partner-card__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.partner-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.partner-card__link:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}

</style>
