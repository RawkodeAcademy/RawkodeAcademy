---
import FAQJsonLD from "@/components/html/faq-jsonld.astro";
import PartnershipApplicationForm from "@/components/organizations/PartnershipApplicationForm.vue";
import PartnershipProof from "@/components/organizations/PartnershipProof.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	fitProofReview,
	partnershipBoundaries,
	partnershipOffer,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const faqs = [
	{
		question: "How does Slack access work?",
		answer:
			"Slack Connect is for questions, reviews and decisions about the agreed workflow. Questions are normally answered within two business days. Larger requests are prioritised within the monthly session and quarterly work, or scoped separately. Slack access does not include on-call support or incident response.",
	},
	{
		question: "What do we need to provide?",
		answer:
			"A working environment and code, a technical expert to join the webinar, the relevant documentation or repository, and timely factual review. Your team maintains the environment and code, handles fixes and owns implementation. We agree what is needed before the cycle starts.",
	},
	{
		question: "What does the quarterly webinar involve?",
		answer:
			"One joint webinar each quarter, with David and your technical expert. Your team supplies the working environment and code. David reviews the technical story, shapes the session and co-hosts, while your expert brings the product detail.",
	},
	{
		question: "What is the practical takeaway?",
		answer:
			"One practical takeaway accompanies the quarterly webinar: a short PDF guide or a runnable example code repository, chosen for the topic. Your team supplies the working code and handles fixes; David reviews it and helps shape what practitioners need. Ongoing repository maintenance is outside the programme.",
	},
	{
		question: "How do we review progress?",
		answer:
			"The monthly working session is where we review technical questions, decisions and what to improve next. A short recap in Slack captures decisions and next steps, without a separate quarterly report. Before the cycle ends, we discuss whether another 90 days would help.",
	},
	{
		question: "How does renewal work?",
		answer:
			"The initial commitment is 90 days at £12,000, paid in three monthly instalments of £4,000. Before it ends, we review the work and agree whether to continue for another 90-day cycle, with its own workflow, webinar topic, practical takeaway and dates.",
	},
	{
		question: "How does the review credit work?",
		answer:
			"Start Adoption Advisory within 30 days of the Fit & Proof Review readout and the £2,500 review fee is credited against your first £4,000 invoice. That leaves £1,500 on the first invoice, followed by two £4,000 invoices. Including the review payment, the total for the review and initial partnership cycle is £12,000. For the same workflow, the review replaces onboarding.",
	},
	{
		question: "How is additional work handled?",
		answer:
			"We agree its scope, price and timing before it starts. Requests for another workflow, extra webinars, new integrations or campaign work do not automatically become part of the retainer.",
	},
];

const process = [
	{
		step: "01",
		title: "Bring one adoption problem",
		body: "Tell us which developers or platform teams need to evaluate the product, what they need to see and where the current demonstration falls short.",
	},
	{
		step: "02",
		title: "Choose the topic together",
		body: "Together, we'll choose a useful technical topic and turn it into a webinar and a practical resource developers can use. Your technical expert brings the working environment and code; David reviews, shapes and co-hosts.",
	},
	{
		step: "03",
		title: "Review, demonstrate and decide",
		body: "Use Slack and monthly sessions to address practitioner questions and improve the technical proof. David and your technical expert co-host the quarterly webinar, with a practical takeaway for the topic. A short recap in Slack captures decisions and next steps; we agree together whether another cycle would help.",
	},
];

const badFits = partnershipBoundaries;
const applyHref = `/organizations/partnerships?route=${encodeURIComponent(partnershipOffer.name)}#apply`;
const reviewApplyHref = `/organizations/partnerships?route=${encodeURIComponent(fitProofReview.name)}#apply`;
---

<Page
	title="Partnerships"
	description="Rawkode Academy's Adoption Advisory partner programme for infrastructure companies that need technical proof, useful demos, and practitioner trust."
>
	<FAQJsonLD questions={faqs} slot="extra-head" />
	<EditorialShell
		eyebrow="Rawkode Partner Programme"
		title="Turn technical depth into practitioner trust."
		lede={partnershipOffer.summary}
	>
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href={applyHref} data-apply-path={partnershipOffer.name}>Apply for Adoption Advisory</a>
			<a class="editorial-button editorial-button--secondary" href="#programme">See the programme</a>
		</div>

		<PartnershipProof />

		<section id="programme" class="editorial-section editorial-section--split" aria-labelledby="programme-title">
			<div class="editorial-section__header">
				<h2 id="programme-title" class="editorial-section__title">{partnershipOffer.name}</h2>
				<p class="editorial-section__lede">Work with David on one important technical workflow over 90 days. Ongoing Slack access and monthly working sessions give your team a practitioner's perspective on buyer objections, technical claims and what to improve. The quarterly joint webinar and practical takeaway bring that advice into technical proof your team can use.</p>
				<p class="editorial-section__lede">Your team keeps ownership of the product, implementation and campaign execution, supplies the working environment and code, and handles fixes. David reviews the technical story, shapes the webinar and co-hosts with your technical expert.</p>
			</div>
			<div class="partner-offer-card">
				<div>
					<p class="partner-offer-card__price">{partnershipOffer.price}</p>
					<p class="partner-offer-card__cadence">{partnershipOffer.cadence}</p>
				</div>
				<p class="editorial-card__body">Each 90-day cycle includes:</p>
				<ul class="editorial-list">
					{partnershipOffer.included.map((item) => <li>{item}</li>)}
				</ul>
				{partnershipOffer.notes.map((note) => <p class="editorial-card__body">{note}</p>)}
				<a class="editorial-button" href={applyHref} data-apply-path={partnershipOffer.name}>Apply for the programme</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="review-title">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Optional starting point</p>
				<h2 id="review-title" class="editorial-section__title">{fitProofReview.name}</h2>
				<p class="editorial-section__lede">{fitProofReview.summary}</p>
			</div>
			<div class="partner-offer-card">
				<div>
					<p class="partner-offer-card__price">{fitProofReview.price}</p>
					<p class="partner-offer-card__cadence">{fitProofReview.cadence}</p>
				</div>
				<ul class="editorial-list">
					{fitProofReview.included.map((item) => <li>{item}</li>)}
				</ul>
				{fitProofReview.notes.map((note) => <p class="editorial-card__body">{note}</p>)}
				<a class="partner-card__link" href={reviewApplyHref} data-apply-path={fitProofReview.name}>Start with a fit review</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="process-title">
			<div class="editorial-section__header">
				<h2 id="process-title" class="editorial-section__title">How it starts</h2>
			</div>
			<div class="partner-process">
				{process.map((item) => (
					<article class="partner-process__item">
						<span class="partner-process__step">{item.step}</span>
						<h3 class="editorial-card__title">{item.title}</h3>
						<p class="editorial-card__body">{item.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="boundaries-title">
			<div class="editorial-section__header">
				<h2 id="boundaries-title" class="editorial-section__title">Clear boundaries</h2>
			</div>
			<ul class="editorial-list partner-boundaries">
				{badFits.map((item) => <li>{item}</li>)}
			</ul>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="faq-title">
			<div class="editorial-section__header">
				<h2 id="faq-title" class="editorial-section__title">Before you apply</h2>
			</div>
			<div class="editorial-faq">
				{faqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section id="apply" class="editorial-section editorial-section--split partnerships-apply" aria-labelledby="apply-title">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Apply</p>
				<h2 id="apply-title" class="editorial-section__title">Bring the next adoption problem.</h2>
				<p class="editorial-section__lede">Tell us which developers or platform teams need to understand the product, what they need to see and which workflow you want to work on over the next 90 days. Rough context is enough.</p>
			</div>
			<div class="partnerships-apply__body">
				<PartnershipApplicationForm client:visible />
			</div>
		</section>
	</EditorialShell>
</Page>

<style>
	.partner-process__step {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--colors-academy-accent);
	}

	.partner-offer-card {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.partner-offer-card__price {
		margin: 0.4rem 0 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.9rem, 5vw, 2.8rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--colors-academy-text);
	}

	.partner-offer-card__cadence {
		margin: 0.15rem 0 0;
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
	}

	.partner-card__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.partner-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.partner-card__link:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}

	.partner-process {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--colors-academy-border);
		border-bottom: 1px solid var(--colors-academy-border);
	}

	.partner-process__item {
		display: grid;
		gap: 0.5rem;
		padding: 1rem 0;
	}

	.partner-process__item + .partner-process__item {
		border-top: 1px solid var(--colors-academy-border);
	}

	.partner-process__item h3 {
		margin: 0;
	}

	.partner-boundaries {
		margin: 0;
	}

	@media (min-width: 760px) {
		.partner-process__item {
			padding: 1rem;
		}
	}
</style>
