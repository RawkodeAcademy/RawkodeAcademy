---
import PartnershipExperience from "@/components/organizations/PartnershipExperience.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	organizationsStartingPoint,
	partnershipDescription,
	partnershipHeroLede,
	partnershipOffer,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;
---

<Page title="For teams building developer products | Rawkode Academy" description={partnershipDescription}>
	<EditorialShell eyebrow="For teams building products for developers" title="Build a product developers want to use." lede={partnershipHeroLede}>
		<p class="partnership-hero-intro" slot="intro">{organizationsStartingPoint}</p>
		<div class="partnership-hero-offer" slot="actions">
			<p class="partnership-hero-commitment">{partnershipOffer.price} for the first 90 days</p>
			<div class="editorial-actions">
				<a class="editorial-button" href="/organizations/partnerships#programme">Explore the partnership</a>
			</div>
		</div>

		<PartnershipExperience compact />

		<section id="programme" class="editorial-section editorial-section--split" aria-labelledby="programme-title">
			<div class="editorial-section__header">
				<h2 id="programme-title" class="editorial-section__title">{partnershipOffer.name}</h2>
			</div>
			<div class="organizations-offer">
				<p class="editorial-card__body">Ongoing advice through Slack and one 60-minute working session each month, with a written recap of decisions and next steps. Includes one joint webinar every 90 days and one supporting PDF guide or runnable code resource.</p>
				<p class="editorial-card__body">The first commitment is £12,000 for 90 days, billed at £4,000 per month when starting directly. We agree together whether to continue for another 90 days.</p>
				<a class="organizations-card__link" href="/organizations/partnerships#programme">Explore the partnership and scope</a>
			</div>
		</section>

		<section id="review" class="editorial-section editorial-section--split" aria-labelledby="review-title">
			<div class="editorial-section__header">
				<h2 id="review-title" class="editorial-section__title">Prefer to start with a product review?</h2>
			</div>
			<div class="organizations-offer">
				<p class="editorial-card__body">For £5,000, get a report on the agreed areas of your product, priorities for what to improve, explain and teach, and a one-hour discussion.</p>
				<p class="editorial-card__body">Start the partnership within 14 days of the review call and the full £5,000 is credited towards the first £12,000, 90-day commitment, leaving £7,000 to pay. The review and first 90 days cost £12,000 in total.</p>
				<a class="organizations-card__link" href="/organizations/partnerships#review">Explore the product review</a>
			</div>
		</section>
	</EditorialShell>
</Page>

<style>
	.partnership-hero-intro { margin: 0; max-width: 68ch; font-family: var(--fonts-academy-text), system-ui, sans-serif; font-size: 1.125rem; line-height: 1.7; color: var(--colors-academy-text-muted); }
	.partnership-hero-offer { display: grid; gap: 1rem; }
	.partnership-hero-commitment { margin: 0; font-family: var(--fonts-academy-text), system-ui, sans-serif; font-size: 1.25rem; font-weight: 750; color: var(--colors-academy-text); }

	.organizations-offer {
		display: grid;
		gap: 1rem;
	}

	.organizations-offer > a { justify-self: start; }

	.organizations-card__link:focus-visible { outline: 2px solid var(--colors-academy-accent); outline-offset: 4px; }

	.organizations-card__link {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.organizations-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

</style>
