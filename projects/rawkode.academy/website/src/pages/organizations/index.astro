---
import PartnershipProof from "@/components/organizations/PartnershipProof.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	decisionBriefMailto,
	fitProofReview,
	partnershipOffer,
	partnershipStartingPoint,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const questions = [
	{
		question: "Why work together over 90 days?",
		answer:
			"Your product, developers and industry keep changing. Over 90 days, we help your marketing, product and engineering teams revisit which features and fixes matter and what to explain or teach next. Marketing that misses what developers need can weaken trust, and trust can be hard to earn back. Slack and the monthly session give us a way to work through those decisions together.",
	},
	{
		question: "What does our team need to provide?",
		answer:
			"Your team provides access to your product and relevant material. For the webinar and runnable example, you supply the working environment and code, and a technical expert for the webinar. You keep ownership of the product and code, maintain the environment and handle fixes.",
	},
	{
		question: "What do we agree before starting?",
		answer:
			"Who writes the guide or prepares the repository, where the webinar runs, how it is promoted, whether it is recorded and how any recording may be reused. We agree those details together before starting.",
	},
	{
		question: "What does the partnership cover?",
		answer:
			"We agree the work, priorities and responsibilities before starting. It can cover developer relations, developer marketing, backlog priorities and defining ideal customers. We also help plan and co-host the webinar. Your team builds the product and handles fixes. Extra webinars, new integrations, on-call support, incident response and ongoing repository maintenance are not included. We give honest feedback; praise, leads and separate coverage are not guaranteed. Any extra work or exclusivity needs a separate agreement.",
	},
];
---

<Page
	title="For Organizations"
	description="A £12,000, 90-day partnership for developer-product teams: ongoing judgement across marketing, product and engineering. Optional £5,000 product review."
>
	<EditorialShell
		eyebrow="For developer-product teams"
		title="Stay relevant to the developers you want to reach."
		lede={partnershipStartingPoint}
	>
		<div class="partnership-hero-offer" slot="actions">
			<p class="partnership-hero-commitment">{partnershipOffer.price} for the first 90 days</p>
			<div class="editorial-actions">
				<a class="editorial-button" href="/organizations/partnerships#programme">Explore the 90-day partnership</a>
				<a class="editorial-button editorial-button--secondary" href={decisionBriefMailto}>Apply by email</a>
			</div>
			<a class="organizations-card__link" href="/organizations/partnerships#review">Not ready to commit? See the product review</a>
		</div>

		<section id="programme" class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<h2 class="editorial-section__title">{partnershipOffer.name}</h2>
				<p class="editorial-section__lede">{partnershipOffer.summary}</p>
				{partnershipOffer.notes.map((note) => <p class="editorial-section__lede">{note}</p>)}
			</div>
			<div class="organizations-offer">
				<div>
					<p class="organizations-offer__price">{partnershipOffer.price}</p>
					<p class="organizations-offer__cadence">{partnershipOffer.cadence}</p>
				</div>
				<ul class="editorial-list">
					{partnershipOffer.included.map((item) => <li>{item}</li>)}
				</ul>
				<a class="editorial-button" href="/organizations/partnerships#programme">See how we work together</a>
			</div>
		</section>

		<PartnershipProof />

		<section id="review" class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<p class="editorial-kicker">{fitProofReview.label}</p>
				<h2 class="editorial-section__title">{fitProofReview.name}</h2>
				<p class="editorial-section__lede">{fitProofReview.summary}</p>
			</div>
			<div class="organizations-offer">
				<div>
					<p class="organizations-offer__price">{fitProofReview.price}</p>
				</div>
				<ul class="editorial-list">
					{fitProofReview.included.map((item) => <li>{item}</li>)}
				</ul>
				{fitProofReview.notes.map((note) => <p class="editorial-card__body">{note}</p>)}
				<a class="organizations-card__link" href="/organizations/lets-chat">Ask for a product review</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="questions-title">
			<div class="editorial-section__header">
				<h2 id="questions-title" class="editorial-section__title">Before we start</h2>
			</div>
			<div class="editorial-faq">
				{questions.map((item) => (
					<details>
						<summary>{item.question}</summary>
						<p>{item.answer}</p>
					</details>
				))}
			</div>
		</section>

	</EditorialShell>
</Page>

<style>
	.partnership-hero-offer { display: grid; gap: 1rem; }
	.partnership-hero-commitment { margin: 0; font-family: var(--fonts-academy-text), system-ui, sans-serif; font-size: 1.25rem; font-weight: 750; color: var(--colors-academy-text); }

	.organizations-offer {
		display: grid;
		gap: 1rem;
	}

	.organizations-offer > a { justify-self: start; }

	.organizations-card__link:focus-visible { outline: 2px solid var(--colors-academy-accent); outline-offset: 4px; }

	.organizations-offer__price {
		margin: 0.4rem 0 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--colors-academy-text);
	}

	.organizations-offer__cadence {
		margin: 0.15rem 0 0;
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.875rem;
		letter-spacing: 0.02em;
	}

	.organizations-card__link {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.organizations-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

</style>
