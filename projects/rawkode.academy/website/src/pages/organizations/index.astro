---
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	decisionBriefMailto,
	fitProofReview,
	partnershipOffer,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const reviewScope = [
	{
		term: "What we build",
		detail:
			"One recorded technical walkthrough per 90-day cycle, with a short companion page and two clips taken from the same recording.",
	},
	{
		term: "What we review",
		detail:
			"The documentation, architecture, operational claims and buyer objections relevant to the agreed workflow.",
	},
	{
		term: "Who owns the work",
		detail:
			"Your team supplies and maintains the working demo, environment and integrations. David reviews the technical story, prepares and hosts the walkthrough, and handles the agreed light production.",
	},
];

const proofWork = [
	"Slack Connect for technical questions, reviews and decisions about the agreed workflow",
	"One 60-minute working session each month",
	"One recorded technical walkthrough of up to 45 minutes per cycle",
	"One companion page of up to 500 words and two clips of up to 90 seconds each, drawn from that recording",
	"Light editing, one consolidated correction round and a shared folder of final assets",
	"A one-page quarterly summary, discussed in that month's working session",
];

const reviewWork = [
	"One technical workflow and an agreed set of materials",
	"A written scorecard and prioritised next-step plan",
	"One 60-minute readout",
	"The full £2,500 credited against your first Adoption Advisory invoice when the partnership starts within 30 days of the readout",
];

const badFits = [
	"The work is paid for; the technical judgement stays independent. There is no guarantee of praise, leads or separate editorial coverage.",
	"Product implementation, new integrations, incident response and on-call support stay with your team.",
	"Additional recordings, bespoke articles, campaign management and ongoing repository maintenance are outside the package.",
	"New creative direction, additional formats and reshoots caused by changed requirements are scoped separately.",
	"Exclusivity is considered only for a specifically agreed scope and price.",
];
---

<Page
	title="For Organizations"
	description="Rawkode Academy partnerships for infrastructure companies that need sharper technical proof, useful demos, and practitioner trust."
>
	<EditorialShell
		eyebrow="For Organizations"
		title="Partner with Rawkode Academy"
		lede="We help infrastructure companies show technical buyers what their products can do. Work with David on one important workflow, get a practitioner's feedback and turn a working demo into useful material your team can reuse."
	>
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href="/organizations/partnerships">Explore the programme</a>
			<a class="editorial-button editorial-button--secondary" href={decisionBriefMailto}>Apply by email</a>
		</div>

		<p class="editorial-section__lede">Your team owns the product, implementation and campaign execution. David brings technical judgement, shapes the demonstration and produces the agreed assets.</p>

		<section class="editorial-section">
			<dl class="organizations-scope">
				{reviewScope.map((row) => (
					<div class="organizations-scope__row">
						<dt>{row.term}</dt>
						<dd>{row.detail}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<h2 class="editorial-section__title">Adoption Advisory</h2>
				<p class="editorial-section__lede">Work with David on one technical workflow over 90 days. Use Slack and a monthly working session to address the questions a practitioner would ask, improve the demonstration and decide what needs to change.</p>
			</div>
			<div class="organizations-offer">
				<div>
					<p class="organizations-offer__price">{partnershipOffer.price}</p>
					<p class="organizations-offer__cadence">{partnershipOffer.cadence}</p>
				</div>
				<ul class="editorial-list">
					{proofWork.map((item) => <li>{item}</li>)}
				</ul>
				<p class="editorial-card__body">We agree the workflow, materials and delivery dates before the cycle starts. Your team handles implementation, product fixes and campaign execution.</p>
				<a class="editorial-button" href="/organizations/partnerships">See what is included</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<h2 class="editorial-section__title">{fitProofReview.name}</h2>
				<p class="editorial-section__lede">Find the gaps in one important technical evaluation journey. David reviews the agreed demo and supporting materials, identifies the three most important proof gaps and recommends what to fix or demonstrate next.</p>
			</div>
			<div class="organizations-offer">
				<div>
					<p class="organizations-offer__price">{fitProofReview.price}</p>
					<p class="organizations-offer__cadence">{fitProofReview.cadence}</p>
				</div>
				<ul class="editorial-list">
					{reviewWork.map((item) => <li>{item}</li>)}
				</ul>
				<p class="editorial-card__body">If you continue with the same workflow, the review becomes your onboarding. The findings and next-step plan are yours to use whether or not you continue.</p>
				<a class="organizations-card__link" href="/organizations/lets-chat">Start a fit check</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<h2 class="editorial-section__title">What the programme does not promise</h2>
			</div>
			<ul class="organizations-list">
				{badFits.map((item) => <li>{item}</li>)}
			</ul>
		</section>
	</EditorialShell>
</Page>

<style>
	.organizations-scope {
		margin: 0;
		border-top: 1px solid var(--colors-academy-border);
		border-bottom: 1px solid var(--colors-academy-border);
	}

	.organizations-scope__row {
		display: grid;
		gap: 0.35rem;
		padding: 0.9rem 0;
	}

	.organizations-scope__row + .organizations-scope__row {
		border-top: 1px solid var(--colors-academy-border);
	}

	.organizations-scope dt {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--colors-academy-accent);
	}

	.organizations-scope dd {
		margin: 0;
		color: var(--colors-academy-text-soft);
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: 0.98rem;
		line-height: 1.55;
	}

	.organizations-offer {
		display: grid;
		gap: 1rem;
	}

	.organizations-offer > a { justify-self: start; }

	.organizations-card__link:focus-visible { outline: 2px solid var(--colors-academy-accent); outline-offset: 4px; }

	.organizations-offer__price {
		margin: 0.4rem 0 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--colors-academy-text);
	}

	.organizations-offer__cadence {
		margin: 0.15rem 0 0;
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
	}

	.organizations-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.organizations-list li {
		border-bottom: 1px solid var(--colors-academy-border);
		padding: 0.8rem 0;
		color: var(--colors-academy-text-soft);
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.organizations-card__link {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.organizations-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (min-width: 760px) {
		.organizations-scope__row {
			grid-template-columns: minmax(11rem, 0.28fr) minmax(0, 1fr);
			gap: 1.5rem;
			align-items: baseline;
		}
	}
</style>
