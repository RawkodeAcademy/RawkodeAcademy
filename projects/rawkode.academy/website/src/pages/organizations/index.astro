---
import PartnershipProof from "@/components/organizations/PartnershipProof.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	decisionBriefMailto,
	fitProofReview,
	partnershipOffer,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const reviewScope = [
	{
		term: "What you get",
		detail:
			"One webinar every 90 days, co-hosted by David and your technical expert, plus one short PDF guide or a code repository with an example developers can run.",
	},
	{
		term: "What we review",
		detail:
			"Your demo, documentation and the questions developers ask when deciding whether to use your product.",
	},
	{
		term: "Who owns the work",
		detail:
			"Your team supplies and maintains the environment and code, and handles fixes. David reviews the demo, helps plan the webinar and co-hosts with your technical expert.",
	},
];

const proofWork = partnershipOffer.included;

const reviewWork = fitProofReview.included;

const badFits = [
	"David gives honest feedback. Praise, leads and separate coverage are not guaranteed.",
	"Building and fixing your product, new integrations, incident response and on-call support stay with your team.",
	"Extra webinars, managing campaigns and ongoing code repository maintenance are outside the partnership.",
	"Exclusivity needs a separate agreement on the work and price.",
];
---

<Page
	title="For Organizations"
	description="Work with David on your product demo and documentation, ask questions in Slack, and co-host a webinar. Or start with a £2,500 product demo review."
>
	<EditorialShell
		eyebrow="For Organizations"
		title="Partner with Rawkode Academy"
		lede={partnershipOffer.summary}
	>
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href="/organizations/partnerships">See what you get</a>
			<a class="editorial-button editorial-button--secondary" href={decisionBriefMailto}>Apply by email</a>
		</div>

		<p class="editorial-section__lede">Your team builds the product, fixes problems and runs your campaigns. David answers technical questions, reviews the demo, helps plan the webinar and co-hosts it with your technical expert.</p>

		<section class="editorial-section">
			<dl class="organizations-scope">
				{reviewScope.map((row) => (
					<div class="organizations-scope__row">
						<dt>{row.term}</dt>
						<dd>{row.detail}</dd>
					</div>
				))}
			</dl>
		</section>

		<PartnershipProof />

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<h2 class="editorial-section__title">{partnershipOffer.name}</h2>
				<p class="editorial-section__lede">Work on one agreed use case with David for 90 days. Ask questions in Slack and meet each month to review your demo, documentation and what developers need to understand. You get feedback throughout the three months, plus a joint webinar and one guide or code example.</p>
			</div>
			<div class="organizations-offer">
				<div>
					<p class="organizations-offer__price">{partnershipOffer.price}</p>
					<p class="organizations-offer__cadence">{partnershipOffer.cadence}</p>
				</div>
				<ul class="editorial-list">
					{proofWork.map((item) => <li>{item}</li>)}
				</ul>
				{partnershipOffer.notes.map((note) => <p class="editorial-card__body">{note}</p>)}
				<a class="editorial-button" href="/organizations/partnerships">See what is included</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<h2 class="editorial-section__title">{fitProofReview.name}</h2>
				<p class="editorial-section__lede">{fitProofReview.summary}</p>
			</div>
			<div class="organizations-offer">
				<div>
					<p class="organizations-offer__price">{fitProofReview.price}</p>
					<p class="organizations-offer__cadence">{fitProofReview.cadence}</p>
				</div>
				<ul class="editorial-list">
					{reviewWork.map((item) => <li>{item}</li>)}
				</ul>
				{fitProofReview.notes.map((note) => <p class="editorial-card__body">{note}</p>)}
				<a class="organizations-card__link" href="/organizations/lets-chat">Ask for a demo review</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<h2 class="editorial-section__title">What is not included</h2>
			</div>
			<ul class="organizations-list">
				{badFits.map((item) => <li>{item}</li>)}
			</ul>
		</section>
	</EditorialShell>
</Page>

<style>
	.organizations-scope {
		margin: 0;
		border-top: 1px solid var(--colors-academy-border);
		border-bottom: 1px solid var(--colors-academy-border);
	}

	.organizations-scope__row {
		display: grid;
		gap: 0.35rem;
		padding: 0.9rem 0;
	}

	.organizations-scope__row + .organizations-scope__row {
		border-top: 1px solid var(--colors-academy-border);
	}

	.organizations-scope dt {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--colors-academy-accent);
	}

	.organizations-scope dd {
		margin: 0;
		color: var(--colors-academy-text-soft);
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: 0.98rem;
		line-height: 1.55;
	}

	.organizations-offer {
		display: grid;
		gap: 1rem;
	}

	.organizations-offer > a { justify-self: start; }

	.organizations-card__link:focus-visible { outline: 2px solid var(--colors-academy-accent); outline-offset: 4px; }

	.organizations-offer__price {
		margin: 0.4rem 0 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--colors-academy-text);
	}

	.organizations-offer__cadence {
		margin: 0.15rem 0 0;
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
	}

	.organizations-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.organizations-list li {
		border-bottom: 1px solid var(--colors-academy-border);
		padding: 0.8rem 0;
		color: var(--colors-academy-text-soft);
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.organizations-card__link {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.organizations-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (min-width: 760px) {
		.organizations-scope__row {
			grid-template-columns: minmax(11rem, 0.28fr) minmax(0, 1fr);
			gap: 1.5rem;
			align-items: baseline;
		}
	}
</style>
