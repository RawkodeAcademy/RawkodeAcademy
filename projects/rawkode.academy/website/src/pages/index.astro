---
import { academyPage } from "@rawkodeacademy/design-system";
import AcademyPage from "@/components/academy/AcademyPage.vue";
import NewsletterCTA from "@/components/newsletter/NewsletterCTA.astro";
import Page from "@/wrappers/page.astro";
import { getHomepageContent } from "@/lib/content";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";

const styles = academyPage();

// The homepage is format-agnostic. Collection routes such as /watch and
// /read remain focused, but Latest is one chronological stream of everything
// the Academy publishes.
const { latest, videos: publishedVideos, learningPaths, counts } =
	await getHomepageContent(12);

const compactCopy = (value: string | undefined, maxLength = 220) => {
	const normalized = (value ?? "").replace(/\s+/g, " ").trim();
	if (!normalized)
		return "Practical cloud native education from Rawkode Academy.";
	const firstSentence = normalized.match(/^.*?[.!?](?:\s|$)/)?.[0]?.trim();
	if (firstSentence && firstSentence.length <= maxLength) return firstSentence;
	if (normalized.length <= maxLength) return normalized;
	return `${normalized.slice(0, maxLength).trimEnd()}…`;
};

const formatDuration = (seconds?: number | null) => {
	if (!seconds || seconds <= 0) return "Recorded session";
	const minutes = Math.floor(seconds / 60);
	if (minutes < 60) return `${minutes} min`;
	const hours = Math.floor(minutes / 60);
	const remainder = minutes % 60;
	return remainder > 0 ? `${hours}h ${remainder}m` : `${hours}h`;
};

const formatPathDuration = (minutes?: number | null) => {
	if (!minutes || minutes <= 0) return "Self-paced";
	if (minutes < 60) return `${minutes} min core video`;
	const hours = Math.floor(minutes / 60);
	const remainder = minutes % 60;
	return remainder > 0 ? `${hours}h ${remainder}m core video` : `${hours}h core video`;
};

const videos = publishedVideos.slice(0, 1).map((video) => ({
	href: `/watch/${video.data.slug}`,
	title: video.data.title,
	description: compactCopy(video.data.subtitle || video.data.description),
	meta: [
		video.data.type === "live" ? "Live session" : "Recorded session",
		formatDuration(video.data.duration),
	],
	mediaSrc: getVideoThumbnailUrl(video.data.id),
}));

const paths = learningPaths.slice(0, 8).map((path) => ({
		href: `/learning-paths/${path.slug}`,
	title: path.data.title,
	description: compactCopy(path.data.description),
	meta: [
		path.data.difficulty.charAt(0).toUpperCase() +
			path.data.difficulty.slice(1),
		formatPathDuration(path.data.estimatedDuration),
	] as [string, string],
}));

const featured = videos[0] ?? {
	href: "/watch",
	title: "Cloud native is complex. It does not need to be hard.",
	description:
		"Hands-on cloud native lessons and build sessions for engineers, taught by people who run production systems.",
	meta: ["Rawkode Academy", "Start here"],
};
const featuredMedia = "mediaSrc" in featured ? featured.mediaSrc : undefined;

// Keep archive figures in sync with the homepage's published collection reads.
// The video read is complete; other figures retain their existing 100-item window.
const plural = (count: number, singular: string, pluralForm = `${singular}s`) =>
	count === 1 ? singular : pluralForm;
const archive = [
	{
		href: "/watch",
		value: `${counts.videos}`,
		label: plural(counts.videos, "Video"),
	},
	{
		href: "/read",
		value: `${counts.articles}`,
		label: plural(counts.articles, "Article"),
	},
	{
		href: "/learning-paths",
		value: `${counts.learningPaths}`,
		label: plural(counts.learningPaths, "Learning path"),
	},
	{
		href: "/courses",
		value: `${counts.courses}`,
		label: plural(counts.courses, "Course"),
	},
].filter((link) => link.value !== "0");

const pageTitle = "Cloud Native & Kubernetes Education";
const pageDescription =
	"Hands-on cloud native education and partnerships from Rawkode Academy for engineers and teams shipping production systems.";

Astro.response.headers.set(
	"Cache-Control",
	"public, max-age=60, s-maxage=300, stale-while-revalidate=3600",
);
Astro.response.headers.set("CDN-Cache-Control", "public, max-age=300");
Astro.response.headers.set("Cache-Tag", "homepage");
Astro.response.headers.set("X-Build-Time", new Date().toISOString());
---

<Page title={pageTitle} description={pageDescription}>
		{featuredMedia && (
			<link
				slot="extra-head"
				rel="preload"
				as="image"
				href={featuredMedia}
				fetchpriority="high"
			/>
		)}
		<AcademyPage
			page="home"
			featured={featured}
			latest={latest}
			learningPaths={paths}
			archive={archive}
		/>
		<div id="join" class={styles.section}>
			<NewsletterCTA
				badge="Rawkode Academy newsletter"
				headline="Keep learning"
				subtitle="New sessions, articles, and courses from the Academy, sent when they publish. Nothing else."
			/>
		</div>
</Page>

<script>
	import { mountSystem } from "@/lib/system-canvas";

	const hero = document.querySelector<HTMLElement>("[data-system]");
	if (hero) mountSystem(hero);
</script>
