---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class="editorial-section editorial-section--split" aria-labelledby="experience-title">
	<div class="editorial-section__header">
		<h2 id="experience-title" class="editorial-section__title">{compact ? "Experience from engineering and teaching" : "Experience that stays close to developers"}</h2>
	</div>
	<div class="partnership-experience">
		{compact ? (
			<p class="editorial-card__body">I speak with hundreds of developers each month, sometimes thousands. I bring those conversations and hands-on experience across embedded systems, cloud-native platforms and AI infrastructure into the questions your team is working through.</p>
		) : (
			<>
				<p class="editorial-card__body">I speak with hundreds of developers each month, sometimes thousands. Those conversations, alongside hands-on engineering and teaching, shape my view of the tools people use, the problems they face and the changes worth paying attention to.</p>
				<p class="editorial-card__body">My engineering work spans embedded systems, cloud-native platforms and AI infrastructure. I bring that experience into your team's decisions, alongside what we learn from your product and your own customer feedback.</p>
			</>
		)}
		<p class="editorial-card__body">David Flanagan, founder of Rawkode Academy</p>
		<p class="editorial-card__body"><a href="https://rawkode.dev/biography/">{compact ? "See David's background and work" : "Read David's engineering background"}</a></p>
	</div>
</section>

<style>
	.partnership-experience { display: grid; gap: 1rem; }
	.partnership-experience a { color: var(--colors-academy-accent); text-underline-offset: 0.2em; }
	.partnership-experience a:focus-visible { outline: 2px solid var(--colors-academy-accent); outline-offset: 4px; }
</style>
