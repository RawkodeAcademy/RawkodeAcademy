---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class="editorial-section editorial-section--split" aria-labelledby="experience-title">
	<div class="editorial-section__header">
		<h2 id="experience-title" class="editorial-section__title">You work with David directly</h2>
	</div>
	<div class="partnership-experience">
		<p class="editorial-card__body">No account managers and no hand-offs. David Flanagan founded Rawkode Academy and hosts Rawkode Live and Klustered, where he has spent years trying new tools live with their maintainers and watching engineers break and repair Kubernetes clusters.</p>
		{!compact && (
			<p class="editorial-card__body">His engineering work spans embedded systems, cloud-native platforms and AI infrastructure, and he has worked inside developer-tool companies including Equinix Metal, InfluxData and Pulumi. That is the view he brings to your product: what a capable engineer expects in the first hour, where they give up, and what makes them come back.</p>
		)}
	</div>
</section>

<style>
	.partnership-experience { display: grid; gap: 1rem; }
</style>
