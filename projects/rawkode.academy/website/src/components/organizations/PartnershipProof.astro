---
import { getCollection } from "astro:content";
import { getPublishedVideos } from "@/lib/content";
import { partnershipIsNewNote } from "@/lib/partnerships";
import { getSiteStats } from "@/lib/site-stats";

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;

const academyStats = await getSiteStats();
const videos = await getPublishedVideos();

const showId = (value: unknown): string | null => {
	if (!value) return null;
	if (typeof value === "string") return value;
	if (typeof value === "object" && "id" in value) {
		const id = (value as { id?: unknown }).id;
		return typeof id === "string" ? id : null;
	}
	return null;
};

const episodesFor = (id: string) =>
	videos.filter((video) => showId(video.data.show) === id).length;

const rawkodeLiveEpisodes = episodesFor("rawkode-live");
// Public first runs: episodes where David works through a tool for the first time.
const firstRunEpisodes = videos.filter((video) =>
	String(video.data.slug ?? video.id).startsWith("hands-on-introduction"),
).length;
const klusteredEpisodes = episodesFor("klustered");

// Testimonials come from the content collection so the quotes on this page
// are the same words people gave us, attributed the same way.
const featuredIds = compact
	? ["reggie-wilkerson", "solomon-hykes"]
	: ["jens-neuse", "reggie-wilkerson", "solomon-hykes", "mikkel-hegnhoj"];
const context: Record<string, string> = {
	"reggie-wilkerson":
		"On advisory work: positioning, demos and ongoing guidance",
	"mikkel-hegnhoj":
		"On Advent of Spin, the hands-on challenges Rawkode Academy created for Fermyon",
	"solomon-hykes": "On having his product used live",
	"jens-neuse": "On David's public first run of WunderGraph on Rawkode Live",
};
const testimonials = (await getCollection("testimonials"))
	.filter((entry) => featuredIds.includes(entry.id))
	.sort((a, b) => featuredIds.indexOf(a.id) - featuredIds.indexOf(b.id));

const examples = [
	{
		title: "Equinix Metal: from console to automation",
		detail:
			"While at Equinix Metal, David built the Metal Monday series, which took developers from the console, API and CLI to automation and BGP high availability.",
		sources: [
			{
				label: "Console, API and CLI",
				href: "https://www.youtube.com/watch?v=0XTefee6WYg",
			},
			{
				label: "Automation",
				href: "https://www.youtube.com/watch?v=8mYdGwLj5dQ",
			},
			{
				label: "BGP high availability",
				href: "https://www.youtube.com/watch?v=ku786TprTD8",
			},
		],
	},
	{
		title: "Pulumi: removing repeated work for Kubernetes developers",
		detail:
			"While at Pulumi, David found developers repeatedly generating SDKs for Kubernetes custom resources by hand, and built the automation that generates and publishes them.",
		sources: [
			{
				label: "Kubernetes SDK automation",
				href: "https://www.pulumi.com/blog/kubernetes-sdks-pulumiverse/",
			},
			{
				label: "GitOps with the Pulumi Operator",
				href: "https://www.pulumi.com/blog/improving-gitops-with-pulumi-operator/",
			},
		],
	},
	{
		title: "InfluxData: Kubernetes monitoring with Telegraf",
		detail:
			"While at InfluxData, David worked on the Telegraf Helm tooling and the education that showed how deployment, metric collection and autoscaling fit together.",
		sources: [
			{
				label: "Telegraf Helm chart",
				href: "https://github.com/influxdata/helm-charts/blob/master/charts/telegraf/Chart.yaml",
			},
			{
				label: "Kubernetes monitoring walkthrough",
				href: "https://www.influxdata.com/blog/scaling-kubernetes-deployments-influxdb-flux/",
			},
		],
	},
];
---

<section class="editorial-section editorial-section--split" aria-labelledby="partnership-proof-title">
	<div class="editorial-section__header">
		<h2 id="partnership-proof-title" class="editorial-section__title">Who you'd be working with</h2>
		<p class="editorial-section__lede">David has spent 20 years building, shipping and teaching developer tools, and has run Rawkode Academy since 2019. Over the last four years the Academy has worked with a dozen developer-tool companies, including Fermyon and Guidepad. That experience is what you're paying for.</p>
	</div>
	<div class="partnership-proof">
		<dl class="partnership-proof__stats">
			<div><dt>Years in developer tools</dt><dd>20</dd></div>
			<div><dt>Companies the Academy has worked with in the last four years</dt><dd>A dozen</dd></div>
			<div><dt><a href="/shows/rawkode-live">Rawkode Live</a> episodes</dt><dd>{rawkodeLiveEpisodes}</dd></div>
			<div><dt><a href="/shows/klustered">Klustered</a> episodes</dt><dd>{klusteredEpisodes}</dd></div>
			<div><dt>Public first runs of new tools</dt><dd>{firstRunEpisodes}</dd></div>
		</dl>
		<p class="partnership-proof__meta">{academyStats.videoCount} videos in the <a href="/watch">Academy catalogue</a>, counted when this page was built.</p>

		<p class="editorial-card__body">The audience is platform, cloud-native and infrastructure engineers. Recent sessions include <a href="/watch/manage-and-run-ai-ml-models-as-oci-artifacts-with-oras">running AI/ML models as OCI artifacts with ORAS</a>, <a href="/watch/mcp-servers-for-rust-developers">MCP servers for Rust developers</a> and <a href="/watch/introducing-wassette-securing-mcp-with-webassembly">securing MCP with WebAssembly</a>.</p>

		<p class="editorial-card__body">{partnershipIsNewNote}</p>
		<p class="editorial-card__body">Developer platforms and APIs: <a href="/watch/hands-on-introduction-to-wundergraph">WunderGraph</a> · <a href="/watch/hands-on-introduction-to-dagger">Dagger</a> · <a href="/watch/hands-on-introduction-to-restate">Restate</a>. Data and state: <a href="/watch/hands-on-introduction-to-schemahero">SchemaHero</a> · <a href="/watch/hands-on-introduction-to-litestream">Litestream</a> · <a href="/watch/hands-on-introduction-to-spicedb">SpiceDB</a>.</p>

		<div class="partnership-proof__quotes">
			{testimonials.map((entry) => (
				<figure>
					{context[entry.id] && <p class="partnership-proof__context">{context[entry.id]}</p>}
					<blockquote>{entry.data.quote.trim()}</blockquote>
					<figcaption>
						{entry.data.author.link ? (
							<a href={entry.data.author.link}>{entry.data.author.name}</a>
						) : (
							entry.data.author.name
						)}, {entry.data.author.title}
					</figcaption>
				</figure>
			))}
		</div>

		{!compact && (
			<>
				<p class="editorial-card__body">Before Rawkode Academy, David built and taught developer tools from the inside:</p>
				<ul class="editorial-list">
					{examples.map((example) => (
						<li>
							<h3 class="editorial-card__title">{example.title}</h3>
							<p class="editorial-card__body">{example.detail}</p>
							<p class="editorial-card__body">
								{example.sources.map((source, index) => (
									<>{index > 0 && " · "}<a href={source.href}>{source.label}</a></>
								))}
							</p>
						</li>
					))}
				</ul>
			</>
		)}
		<p class="editorial-card__body"><a href="https://rawkode.dev/biography/">Read David's engineering background</a></p>
	</div>
</section>

<style>
	.partnership-proof { display: grid; gap: 1.5rem; min-width: 0; }
	.partnership-proof a {
		color: var(--colors-academy-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.partnership-proof a:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}
	.partnership-proof__stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1rem;
		margin: 0;
	}
	.partnership-proof__stats div { display: grid; gap: 0.25rem; }
	.partnership-proof__stats dt {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--colors-academy-text-muted);
	}
	.partnership-proof__stats dd {
		margin: 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		font-weight: 750;
		font-variant-numeric: tabular-nums;
		color: var(--colors-academy-text);
	}
	.partnership-proof__meta {
		margin: 0;
		font-size: 0.875rem;
		color: var(--colors-academy-text-muted);
	}
	.partnership-proof__quotes { display: grid; gap: 1.25rem; }
	.partnership-proof__quotes figure { margin: 0; display: grid; gap: 0.5rem; }
	.partnership-proof__quotes blockquote {
		margin: 0;
		padding-left: 1rem;
		border-left: 2px solid var(--colors-academy-accent);
		color: var(--colors-academy-text);
		line-height: 1.65;
	}
	.partnership-proof__context {
		margin: 0;
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--colors-academy-accent);
	}
	.partnership-proof__quotes figcaption {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.8rem;
		color: var(--colors-academy-text-muted);
	}
</style>
