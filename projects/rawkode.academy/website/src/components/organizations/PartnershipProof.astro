---
import { getSiteStats } from "@/lib/site-stats";

const academyStats = await getSiteStats();
const catalogueDate = new Date().toLocaleDateString("en-GB", {
	day: "numeric",
	month: "long",
	year: "numeric",
	timeZone: "UTC",
});

const feedback = [
	{
		name: "Rich Burroughs",
		context: "Loft Labs, July 2021",
		summary:
			"During a Rawkode Live session, David identified testing Kubernetes operators against several cluster versions as a use case for vCluster. Rich Burroughs noted that he had not considered it.",
		sourceHref:
			"https://www.vcluster.com/blog/rawkode-live-hands-on-introduction-to-vcluster",
	},
];

const examples = [
	{
		title: "Equinix Metal: a path from console to automation",
		detail:
			"Built a YouTube learning strategy for cloud-native developers, connecting bare metal and networking to practical work. Metal Monday progressed from console, API and CLI use to automation and BGP high availability.",
		sources: [
			{
				label: "Console, API and CLI",
				href: "https://www.youtube.com/watch?v=0XTefee6WYg",
			},
			{
				label: "Automation",
				href: "https://www.youtube.com/watch?v=8mYdGwLj5dQ",
			},
			{
				label: "BGP high availability",
				href: "https://www.youtube.com/watch?v=ku786TprTD8",
			},
		],
	},
	{
		title: "InfluxData: Kubernetes monitoring with Telegraf",
		detail:
			"Connected Kubernetes monitoring with Telegraf Helm tooling and observability education. The published work links deployment, metric collection and autoscaling so developers can follow the use case in practice.",
		sources: [
			{
				label: "Telegraf Helm chart",
				href: "https://github.com/influxdata/helm-charts/blob/master/charts/telegraf/Chart.yaml",
			},
			{
				label: "Kubernetes monitoring walkthrough",
				href: "https://www.influxdata.com/blog/scaling-kubernetes-deployments-influxdb-flux/",
			},
		],
	},
	{
		title: "Pulumi: workflows for Kubernetes developers",
		detail:
			"Connected hands-on Kubernetes and infrastructure-as-code work to developer experience and developer-facing marketing. Published SDK automation work tackles repeated custom-resource SDK generation and publishing; the GitOps walkthrough separates platform setup from application delivery with the Pulumi Operator.",
		sources: [
			{
				label: "Kubernetes SDK automation",
				href: "https://www.pulumi.com/blog/kubernetes-sdks-pulumiverse/",
			},
			{
				label: "GitOps with the Pulumi Operator",
				href: "https://www.pulumi.com/blog/improving-gitops-with-pulumi-operator/",
			},
		],
	},
];
---

<section class="editorial-section editorial-section--split" aria-labelledby="partnership-proof-title">
	<div class="editorial-section__header">
		<h2 id="partnership-proof-title" class="editorial-section__title">Practical education and product judgement</h2>
		<p class="editorial-section__lede">Academy teaching and hands-on work inside developer-tool companies inform the judgement we bring to your team.</p>
	</div>
	<div class="partnership-proof__items">
		<div class="partnership-proof__academy">
			<p class="editorial-card__body">Rawkode Academy has published hands-on cloud native education <a href="/about">since 2019</a>. <a href="/shows/rawkode-live">Rawkode Live</a> explores tools with maintainers and practitioners; <a href="/shows/klustered">Klustered</a> shows engineers diagnosing and repairing broken Kubernetes clusters.</p>
			<p class="editorial-card__body"><strong>{academyStats.videoCount} published videos</strong> in the <a href="/watch">Academy catalogue</a>.</p>
			<p class="partnership-proof__date">Video catalogue count as of {catalogueDate}.</p>
		</div>
		<p class="editorial-card__body">
			Examples from David Flanagan’s developer advocacy work, backed by twenty years of engineering experience.
			<a href="https://rawkode.dev/biography/">Read his professional background</a>.
		</p>
		<ul class="editorial-list">
			{examples.map((example) => (
				<li>
					<h3 class="editorial-card__title">{example.title}</h3>
					<p class="editorial-card__body">{example.detail}</p>
					<p class="editorial-card__body">
						{example.sources.map((source, index) => (
							<>{index > 0 && " · "}<a href={source.href}>{source.label}</a></>
						))}
					</p>
				</li>
			))}
		</ul>
		{feedback.map((item) => (
			<p class="editorial-card__body">
				{item.summary} <a href={item.sourceHref}>Read the published account ({item.context})</a>.
			</p>
		))}
		<p class="editorial-card__body">
			More technical work: <a href="/watch/building-a-real-application-with-guidepad">building an application with Guidepad</a>
			and <a href="/courses/teleport-for-kubernetes">Teleport for Kubernetes</a>, a six-module course demonstrating Kubernetes access on a local Kind cluster, published 23 March 2026.
		</p>
	</div>
</section>

<style>
	.partnership-proof__academy { display: grid; gap: 0.75rem; }
	.partnership-proof__date { margin: 0; font-family: var(--fonts-academy-text), system-ui, sans-serif; font-size: 0.875rem; line-height: 1.6; color: var(--colors-academy-text-muted); }

	.partnership-proof__items {
		display: grid;
		gap: 1.5rem;
	}

	.partnership-proof__items a {
		color: var(--colors-academy-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.partnership-proof__items a:hover {
		text-decoration-thickness: 2px;
	}

	.partnership-proof__items a:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}
</style>
