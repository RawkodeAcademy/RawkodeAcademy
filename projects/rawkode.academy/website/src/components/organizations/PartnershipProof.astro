---
const feedback = [
	{
		name: "Rich Burroughs",
		context: "on Rawkode Live, Loft Labs, July 2021",
		quote:
			"He has a ton of Kubernetes knowledge, and I find watching someone experienced poke at tools a great way to learn.",
		sourceHref:
			"https://www.loft.sh/blog/rawkode-live-hands-on-introduction-to-vcluster",
	},
];

const examples = [
	{
		title: "Making Kubernetes SDKs easier to use",
		href: "https://www.pulumi.com/blog/kubernetes-sdks-pulumiverse/",
		detail:
			"An authored Pulumi walkthrough shows how to automate Kubernetes custom-resource SDK generation and publishing. December 2021.",
	},
	{
		title: "Building a Real Application with Guidepad",
		href: "/watch/building-a-real-application-with-guidepad",
		detail:
			"Reggie Wilkerson and Matt Citarella join David to build a Node.js application. Published July 2024.",
	},
	{
		title: "Teleport for Kubernetes",
		href: "/courses/teleport-for-kubernetes",
		detail:
			"A published course with practical local Kind demos for exploring secure access to Kubernetes.",
	},
];
---

<section class="editorial-section editorial-section--split" aria-labelledby="partnership-proof-title">
	<div class="editorial-section__header">
		<h2 id="partnership-proof-title" class="editorial-section__title">Experience inside developer-tool companies</h2>
		<p class="editorial-section__lede">Engineering, developer advocacy and practical teaching. We bring that experience to decisions about what developers need and what to improve next.</p>
	</div>
	<div class="partnership-proof__items">
		<p class="editorial-card__body">
			David Flanagan brings twenty years of engineering experience, including developer advocacy at
			<a href="https://www.influxdata.com/blog/rawkode-joins-influxdata/">InfluxData</a>,
			<a href="https://kubernetespodcast.com/episode/198-breaking-k8s-for-fun-and-profit/">Equinix Metal</a> and
			<a href="https://www.pulumi.com/events/gitops-with-github-actions-and-the-pulumi-operator/">Pulumi</a>.
			<a href="https://rawkode.dev/biography/">Read his professional background</a>.
		</p>
		{feedback.map((item) => (
			<figure>
				<blockquote cite={item.sourceHref}>
					<p class="editorial-card__body">&ldquo;{item.quote}&rdquo;</p>
				</blockquote>
				<figcaption class="editorial-card__body">
					<strong>{item.name}</strong>, {item.context}. <a href={item.sourceHref}>Read the full feedback</a>
				</figcaption>
			</figure>
		))}
		<ul class="editorial-list">
			{examples.map((example) => (
				<li>
					<h3 class="editorial-card__title"><a href={example.href}>{example.title}</a></h3>
					<p class="editorial-card__body">{example.detail}</p>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.partnership-proof__items {
		display: grid;
		gap: 1.5rem;
	}

	.partnership-proof__items figure,
	.partnership-proof__items blockquote {
		margin: 0;
	}

	.partnership-proof__items figcaption {
		margin-top: 0.5rem;
	}

	.partnership-proof__items a {
		color: var(--colors-academy-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.partnership-proof__items a:hover {
		text-decoration-thickness: 2px;
	}

	.partnership-proof__items a:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}
</style>
