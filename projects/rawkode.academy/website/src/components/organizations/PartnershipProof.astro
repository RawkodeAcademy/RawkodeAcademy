---
import { getSiteStats } from "@/lib/site-stats";

const academyStats = await getSiteStats();
const catalogueDate = new Date().toLocaleDateString("en-GB", {
	day: "numeric",
	month: "long",
	year: "numeric",
	timeZone: "UTC",
});

const examples = [
	{
		title: "Equinix Metal: from console to automation",
		detail:
			"Built a YouTube learning strategy connecting bare metal and networking to practical cloud-native work. Metal Monday progressed from console, API and CLI use to automation and BGP high availability.",
		sources: [
			{
				label: "Console, API and CLI",
				href: "https://www.youtube.com/watch?v=0XTefee6WYg",
			},
			{
				label: "Automation",
				href: "https://www.youtube.com/watch?v=8mYdGwLj5dQ",
			},
			{
				label: "BGP high availability",
				href: "https://www.youtube.com/watch?v=ku786TprTD8",
			},
		],
	},
	{
		title: "InfluxData: Kubernetes monitoring with Telegraf",
		detail:
			"Connected Kubernetes monitoring with Telegraf Helm tooling and observability education, showing how deployment, metric collection and autoscaling fit together.",
		sources: [
			{
				label: "Telegraf Helm chart",
				href: "https://github.com/influxdata/helm-charts/blob/master/charts/telegraf/Chart.yaml",
			},
			{
				label: "Kubernetes monitoring walkthrough",
				href: "https://www.influxdata.com/blog/scaling-kubernetes-deployments-influxdb-flux/",
			},
		],
	},
	{
		title: "Pulumi: removing repeated work for Kubernetes developers",
		detail:
			"Developers were repeating the work of generating SDKs for Kubernetes custom resources. David described the problem and built automation to generate and publish reusable SDKs.",
		sources: [
			{
				label: "Kubernetes SDK automation",
				href: "https://www.pulumi.com/blog/kubernetes-sdks-pulumiverse/",
			},
			{
				label: "GitOps with the Pulumi Operator",
				href: "https://www.pulumi.com/blog/improving-gitops-with-pulumi-operator/",
			},
		],
	},
];
---

<section class="editorial-section editorial-section--split" aria-labelledby="partnership-proof-title">
	<div class="editorial-section__header">
		<h2 id="partnership-proof-title" class="editorial-section__title">See the work behind the advice</h2>
	</div>
	<div class="partnership-proof__items">
		<div class="partnership-proof__academy">
			<p class="editorial-card__body">Rawkode Academy has published hands-on cloud native education <a href="/about">since 2019</a>. <a href="/shows/rawkode-live">Rawkode Live</a> explores tools with maintainers and practitioners. <a href="/shows/klustered">Klustered</a> shows engineers diagnosing and repairing broken Kubernetes clusters.</p>
			<p class="editorial-card__body"><strong>{academyStats.videoCount} published videos</strong> in the <a href="/watch">Academy catalogue</a>, as of {catalogueDate}.</p>
		</div>
		<p class="editorial-card__body">David's work inside developer-tool companies connects practical engineering with the way developers learn and use a product:</p>
		<ul class="editorial-list">
			{examples.map((example) => (
				<li>
					<h3 class="editorial-card__title">{example.title}</h3>
					<p class="editorial-card__body">{example.detail}</p>
					<p class="editorial-card__body">
						{example.sources.map((source, index) => (
							<>{index > 0 && " · "}<a href={source.href}>{source.label}</a></>
						))}
					</p>
				</li>
			))}
		</ul>
		<p class="editorial-card__body">More hands-on teaching: <a href="/courses/teleport-for-kubernetes">Teleport for Kubernetes</a>, a six-module course demonstrating Kubernetes access on a local Kind cluster, published 23 March 2026.</p>
		<p class="editorial-card__body"><a href="/watch">Explore the Academy catalogue</a> · <a href="/shows/rawkode-live">Watch Rawkode Live</a> · <a href="/shows/klustered">Watch Klustered</a> · <a href="/courses/teleport-for-kubernetes">Explore the Teleport course</a></p>
	</div>
</section>

<style>
	.partnership-proof__academy { display: grid; gap: 0.75rem; }

	.partnership-proof__items {
		display: grid;
		gap: 1.5rem;
	}

	.partnership-proof__items a {
		color: var(--colors-academy-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.partnership-proof__items a:hover {
		text-decoration-thickness: 2px;
	}

	.partnership-proof__items a:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}
</style>
