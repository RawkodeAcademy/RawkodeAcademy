---
/**
 * Companies Rawkode Academy has worked with since 2022, across sponsorships,
 * shows, courses and advisory. Names come from the partner sections the site
 * has published (homepage 2023, partner logo wall 2024–2026). Logos are shown
 * as monochrome marks so the strip reads as one set in both colour schemes.
 */
import armo from "@/components/partner/logos/armo.svg?url";
import controlplane from "@/components/partner/logos/controlplane.svg?url";
import fermyon from "@/components/partner/logos/fermyon.svg?url";
import guidepad from "@/components/partner/logos/guidepad.svg?url";
import heroku from "@/components/partner/logos/heroku.svg?url";
import komodor from "@/components/partner/logos/komodor.png?url";
import microsoft from "@/components/partner/logos/microsoft.svg?url";
import ngrok from "@/components/partner/logos/ngrok.svg?url";
import spectrocloud from "@/components/partner/logos/spectrocloud.svg?url";
import teleport from "@/components/partner/logos/teleport.svg?url";
import wundergraph from "@/components/partner/logos/wundergraph.svg?url";
import zitadel from "@/components/partner/logos/zitadel.svg?url";

interface Company {
	name: string;
	src: string;
	/** Override for marks with unusual padding or proportions. */
	height?: string;
	/** Show the name beside marks that are an icon only. */
	wordmark?: boolean;
}

const companies: Company[] = [
	{ name: "Teleport", src: teleport },
	{ name: "Microsoft Azure", src: microsoft },
	{ name: "Heroku", src: heroku, height: "2.75rem" },
	{ name: "ngrok", src: ngrok },
	{ name: "Spectro Cloud", src: spectrocloud },
	{ name: "Fermyon", src: fermyon },
	{ name: "WunderGraph", src: wundergraph, wordmark: true },
	{ name: "ControlPlane", src: controlplane },
	{ name: "Zitadel", src: zitadel },
	{ name: "Guidepad", src: guidepad },
	{ name: "Komodor", src: komodor },
	{ name: "Armo", src: armo, height: "1.25rem" },
];
---

<figure class="partner-logos" aria-labelledby="partner-logos-caption">
	<figcaption id="partner-logos-caption" class="partner-logos__caption">
		Companies Rawkode Academy has worked with since 2022, on sponsorships, shows, courses and advice
	</figcaption>
	<ul class="partner-logos__list">
		{companies.map((company) => (
			<li class="partner-logos__item">
				<img
					src={company.src}
					alt={company.wordmark ? "" : company.name}
					loading="lazy"
					decoding="async"
					height="28"
					style={company.height ? `height: ${company.height}` : undefined}
				/>
				{company.wordmark && <span class="partner-logos__wordmark">{company.name}</span>}
			</li>
		))}
	</ul>
</figure>

<style>
	.partner-logos {
		display: grid;
		gap: 1rem;
		margin: 0;
	}

	.partner-logos__caption {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--colors-academy-text-muted);
	}

	.partner-logos__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.partner-logos__item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.partner-logos__wordmark {
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: 1.05rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		color: var(--colors-academy-text);
		opacity: 0.72;
	}

	.partner-logos__list img {
		display: block;
		width: auto;
		max-width: 9rem;
		height: 1.75rem;
		object-fit: contain;
		filter: brightness(0);
		opacity: 0.72;
	}

	:global(html.dark) .partner-logos__list img {
		filter: brightness(0) invert(1);
		opacity: 0.8;
	}
</style>
